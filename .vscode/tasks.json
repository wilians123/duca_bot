{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DUCA-T: Frontend Next.js",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "next dev",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "DUCA-T: Backend Python",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 127.0.0.1 --port 8001",
      "options": {
        "cwd": "${workspaceFolder}\\..\\servicio-extraccion"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "uvicorn",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
