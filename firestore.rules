rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{uid} {
      allow read: if ownUser(uid) || admin();
      allow create: if ownUser(uid) || admin();
      allow update: if admin() || (ownUser(uid) && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active);
      allow delete: if false;
    }

    match /tramites/{tramitId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if admin();
    }
  }
}
